#!/usr/bin/env sh
set -e

# Gems live in a named volume, so they can drift from the image whenever the Gemfile
# changes. Reconcile before doing anything else.
if ! bundle check > /dev/null 2>&1; then
  echo "==> Installing gems..."
  bundle install
fi

# An unclean shutdown can leave a stale pidfile that stops Puma from booting.
rm -f tmp/pids/server.pid

# Only the web server needs the database ready. One-off commands shouldn't pay for a
# migration check on every invocation, and the css watcher never touches the database.
if [ "$1" = "bin/rails" ] && [ "$2" = "server" ]; then
  echo "==> Preparing database..."
  bundle exec rails db:prepare
fi

exec "$@"
