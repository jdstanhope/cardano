<% content_for :title, "Create an account — Cardano" %>

<div class="mx-auto max-w-sm px-6 py-16 sm:py-24">
  <h1 class="text-3xl font-semibold tracking-tight">Create an account</h1>
  <p class="mt-3 text-sm leading-relaxed text-slate">
    Accounts keep your games and their variations together.
  </p>

  <%= form_with model: @user, url: registration_path, class: "mt-10 space-y-6" do |form| %>
    <%= render "shared/form_errors", record: @user %>

    <div>
      <%= form.label :email_address, "Email address", class: "block font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            class: "mt-2 block w-full border border-rule bg-white px-3 py-2.5 text-ink focus:border-ink focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password, class: "block font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72,
            class: "mt-2 block w-full border border-rule bg-white px-3 py-2.5 text-ink focus:border-ink focus:outline-none" %>
      <p class="mt-1.5 font-mono text-xs text-slate">At least 8 characters.</p>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm password", class: "block font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
            class: "mt-2 block w-full border border-rule bg-white px-3 py-2.5 text-ink focus:border-ink focus:outline-none" %>
    </div>

    <%= form.submit "Create account",
          class: "w-full cursor-pointer bg-ink px-4 py-3 font-mono text-xs font-medium uppercase tracking-[0.18em] text-paper hover:bg-ink/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
  <% end %>

  <p class="mt-8 border-t border-rule pt-6 text-sm text-slate">
    Already have an account?
    <%= link_to "Sign in", new_session_path, class: "text-ink underline underline-offset-4 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
  </p>
</div>
