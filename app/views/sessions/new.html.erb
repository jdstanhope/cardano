<% content_for :title, "Sign in — Cardano" %>

<div class="mx-auto max-w-sm px-6 py-16 sm:py-24">
  <h1 class="text-3xl font-semibold tracking-tight">Sign in</h1>

  <%= form_with url: session_url, class: "mt-10 space-y-6" do |form| %>
    <div>
      <%= form.label :email_address, "Email address", class: "block font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address],
            class: "mt-2 block w-full border border-rule bg-white px-3 py-2.5 text-ink focus:border-ink focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password, class: "block font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
            class: "mt-2 block w-full border border-rule bg-white px-3 py-2.5 text-ink focus:border-ink focus:outline-none" %>
    </div>

    <%= form.submit "Sign in",
          class: "w-full cursor-pointer bg-ink px-4 py-3 font-mono text-xs font-medium uppercase tracking-[0.18em] text-paper hover:bg-ink/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
  <% end %>

  <div class="mt-8 space-y-2 border-t border-rule pt-6 text-sm text-slate">
    <p>
      New here?
      <%= link_to "Create an account", new_registration_path, class: "text-ink underline underline-offset-4 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
    </p>
    <p><%= link_to "Forgot your password?", new_password_path, class: "underline underline-offset-4 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %></p>
  </div>
</div>
