<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Cardano" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Cardano">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-paper text-ink font-sans antialiased">
    <header class="border-b border-rule">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5">
        <%= link_to root_path, class: "font-mono text-sm font-medium tracking-[0.28em] text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-signal" do %>
          CARDANO
        <% end %>

        <nav data-account-actions aria-label="Account" class="flex items-center gap-5 font-mono text-xs font-medium uppercase tracking-[0.18em]">
          <% if authenticated? %>
            <%= link_to "Games", games_path,
                  class: "text-slate hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink" %>
            <%= link_to "Sign out", session_path, data: { turbo_method: :delete },
                  class: "text-slate hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink" %>
          <% else %>
            <%= link_to "Sign in", new_session_path,
                  class: "text-slate hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink" %>
            <%= link_to "Register", new_registration_path,
                  class: "border border-ink px-3 py-1.5 text-ink hover:bg-ink hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main>
      <% if flash.any? %>
        <div class="mx-auto max-w-5xl space-y-3 px-6 pt-8">
          <%= render "shared/flash" %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="border-t border-rule">
      <div class="mx-auto max-w-5xl px-6 py-6">
        <p class="font-mono text-xs text-slate">
          Every combination evaluated. Exact figures, not estimates.
        </p>
      </div>
    </footer>
  </body>
</html>
