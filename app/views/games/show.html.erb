<% content_for :title, "#{@game.name} — Cardano" %>

<div class="mx-auto max-w-5xl px-6 py-12 sm:py-16">
  <div class="border-b border-rule pb-6">
    <%= link_to "Games", games_path, class: "font-mono text-xs uppercase tracking-[0.18em] text-slate hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
    <div class="mt-2 flex flex-wrap items-baseline justify-between gap-4">
      <h1 class="text-3xl font-semibold tracking-tight"><%= @game.name %></h1>
      <div class="flex flex-wrap items-baseline gap-2">
        <%# Duplicating is how you try something without risking the game you have. %>
        <%= button_to "Duplicate", game_duplicate_path(@game),
              class: "border border-rule px-3 py-1.5 font-mono text-xs font-medium uppercase tracking-[0.18em] text-slate hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
        <%= link_to "Edit", edit_game_path(@game),
              class: "border border-rule px-3 py-1.5 font-mono text-xs font-medium uppercase tracking-[0.18em] text-slate hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
      </div>
    </div>
    <p class="mt-2 font-mono text-xs text-slate">
      <%= @game.reel_count %>&times;<%= @game.row_count %> window &middot;
      rows <%= @game.row_indices.join(", ") %>
    </p>
  </div>

  <div class="grid gap-12 py-10 lg:grid-cols-2">
    <section data-symbols>
      <h2 class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink">Symbols</h2>

      <% if @game.symbols.any? %>
        <ul class="mt-4 divide-y divide-rule border-y border-rule">
          <% @game.symbols.order(:position).each do |symbol| %>
            <li class="flex items-baseline gap-4 py-2.5">
              <span class="w-8 font-mono text-lg text-ink"><%= symbol.code %></span>
              <span class="flex-1 text-sm text-slate">
                <%= symbol.display_name %>
                <% if symbol.wild? %>
                  <span class="ml-2 border border-signal px-1.5 py-0.5 font-mono text-xs uppercase tracking-[0.14em] text-signal">Wild</span>
                <% end %>
              </span>

              <%# Offered only where it can succeed. A symbol named Wild is the wild by
                  its name and cannot be unmarked; while any wild exists, marking
                  another could only ever be refused, so the option is not shown. %>
              <% if symbol.wild? && !symbol.named_wild? %>
                <%= button_to "Not wild", game_symbol_path(@game, symbol),
                      method: :patch, params: { game_symbol: { wild: "0" } },
                      class: "cursor-pointer font-mono text-xs uppercase tracking-[0.14em] text-slate hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
              <% elsif @game.wild_available? %>
                <%= button_to "Mark wild", game_symbol_path(@game, symbol),
                      method: :patch, params: { game_symbol: { wild: "1" } },
                      class: "cursor-pointer font-mono text-xs uppercase tracking-[0.14em] text-slate hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
              <% end %>

              <%= button_to "Remove", game_symbol_path(@game, symbol), method: :delete,
                    form: { data: { turbo_confirm: "Remove #{symbol.display_name}?" } },
                    class: "cursor-pointer font-mono text-xs uppercase tracking-[0.14em] text-slate hover:text-alert focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-4 text-sm text-slate">No symbols yet. Add the first below.</p>
      <% end %>

      <%= form_with model: [ @game, @symbol || @game.symbols.new ], url: game_symbols_path(@game), class: "mt-6 space-y-3" do |form| %>
        <%= render "shared/form_errors", record: (@symbol || @game.symbols.new) %>

        <div class="flex gap-3">
          <div class="w-20">
            <%= form.label :code, class: "block font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink" %>
            <%= form.text_field :code, required: true, maxlength: 4,
                  class: "mt-2 block w-full border border-rule bg-white px-3 py-2 font-mono text-ink focus:border-ink focus:outline-none" %>
          </div>

          <div class="flex-1">
            <%= form.label :name, "Name (optional)", class: "block font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink" %>
            <%= form.text_field :name,
                  class: "mt-2 block w-full border border-rule bg-white px-3 py-2 text-ink focus:border-ink focus:outline-none" %>
          </div>
        </div>

        <% if @game.wild_available? %>
          <div class="flex items-center gap-2">
            <%= form.check_box :wild, class: "h-4 w-4 border-rule text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
            <%= form.label :wild, "Wild — substitutes for other symbols", class: "text-sm text-slate" %>
          </div>
        <% else %>
          <p class="font-mono text-xs text-slate">
            <%= @game.wild_symbol.display_name %> is this game's wild. Naming a symbol
            &ldquo;Wild&rdquo; makes it the wild automatically.
          </p>
        <% end %>

        <%= form.submit "Add symbol",
              class: "cursor-pointer border border-ink px-4 py-2 font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink hover:bg-ink hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
      <% end %>

      <%# What the wild stands in for. A deny list, so a symbol added later is
          substitutable without anyone having to remember to come back here. %>
      <% if (wild = @game.wild_symbol) && @game.symbols.many? %>
        <div class="mt-6 border-t border-rule pt-5">
          <%# Titled for what the control does. "Substitutes for" above checkboxes
              where ticking means the opposite reads as a contradiction. %>
          <h3 class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink">
            <%= wild.display_name %> does not substitute for
          </h3>

          <%= form_with model: wild, url: game_symbol_path(@game, wild), method: :patch, class: "mt-3" do |form| %>
            <%= form.hidden_field :excluded_symbol_ids, multiple: true, value: nil %>

            <p class="text-sm leading-relaxed text-slate">
              By default it substitutes for every other symbol. Tick any it should
              leave alone.
            </p>

            <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
              <% @game.symbols.order(:position).where.not(id: wild.id).each do |symbol| %>
                <label class="flex items-center gap-2 text-sm text-slate">
                  <input type="checkbox"
                         name="game_symbol[excluded_symbol_ids][]"
                         value="<%= symbol.id %>"
                         <%= "checked" unless wild.substitutes_for?(symbol) %>
                         class="h-4 w-4 border-rule text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">
                  <span class="font-mono text-ink"><%= symbol.code %></span>
                  <span class="sr-only">exclude <%= symbol.display_name %></span>
                </label>
              <% end %>
            </div>

            <%= form.submit "Save substitutions",
                  class: "mt-4 cursor-pointer border border-ink px-4 py-2 font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink hover:bg-ink hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
          <% end %>
        </div>
      <% end %>
    </section>

      <%# Named sets a paytable combination can accept: sevens, bars, reds. A symbol
          belongs to several on purpose — a red seven is both a seven and a red. %>
    <section data-symbol-groups>
        <h2 class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink">Groups</h2>

        <% if @game.symbol_groups.any? %>
          <ul class="mt-3 space-y-4">
            <% @game.symbol_groups.each do |group| %>
              <li>
                <%= form_with model: group, url: game_symbol_group_path(@game, group), method: :patch do |form| %>
                  <div class="flex items-baseline justify-between gap-4">
                    <span class="font-mono text-sm text-ink"><%= group.name %></span>

                    <%= button_to "Remove", game_symbol_group_path(@game, group), method: :delete,
                          form: { data: { turbo_confirm: "Remove the #{group.name} group? The symbols stay." } },
                          class: "cursor-pointer font-mono text-xs uppercase tracking-[0.14em] text-slate hover:text-alert focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
                  </div>

                  <div class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
                    <% @game.symbols.order(:position).each do |symbol| %>
                      <label class="flex items-center gap-2 text-sm text-slate">
                        <input type="checkbox"
                               name="symbol_group[game_symbol_ids][]"
                               value="<%= symbol.id %>"
                               <%= "checked" if group.includes_symbol?(symbol) %>
                               class="h-4 w-4 border-rule text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">
                        <span class="font-mono text-ink"><%= symbol.code %></span>
                      </label>
                    <% end %>
                  </div>

                  <%= form.hidden_field :game_symbol_ids, multiple: true, value: nil %>
                  <%= form.submit "Save #{group.name}",
                        class: "mt-2 cursor-pointer font-mono text-xs uppercase tracking-[0.14em] text-slate hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-3 text-sm leading-relaxed text-slate">
            None yet. A group is a set a paytable combination can accept &mdash; sevens,
            bars, reds &mdash; and a symbol can belong to several.
          </p>
        <% end %>

        <%= form_with url: game_symbol_groups_path(@game), scope: :symbol_group, class: "mt-4 flex flex-wrap items-end gap-3" do |form| %>
          <div>
            <%= form.label :name, "New group", class: "block font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink" %>
            <%= form.text_field :name, required: true,
                  class: "mt-2 block w-40 border border-rule bg-white px-3 py-2 text-ink focus:border-ink focus:outline-none" %>
          </div>

          <%= form.submit "Add group",
                class: "cursor-pointer border border-ink px-4 py-2 font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink hover:bg-ink hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
        <% end %>
      </section>

    <%# Paylines have their own page: a twenty-five line set is twenty-five shapes,
        which is more than a column of a summary page can carry. Reached the way
        variations are. %>
    <section data-paylines>
      <% if @game.pays_by_ways? %>
        <h2 class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink">Ways</h2>

        <p class="mt-4 text-sm leading-relaxed text-slate">
          This game pays <span class="font-mono text-ink"><%= number_with_delimiter @game.ways_count %></span>
          ways &mdash; every arrangement of matching symbols on adjacent reels from the
          left, wherever they land. There are no paylines to define.
        </p>

        <p class="mt-2 font-mono text-xs text-slate">
          <%= @game.row_count %> rows across <%= @game.reel_count %> reels, and a spin
          costs one unit per way.
        </p>
      <% else %>
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <h2 class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink">Paylines</h2>

          <%= link_to "Edit paylines", game_paylines_path(@game),
                class: "border border-rule px-3 py-1.5 font-mono text-xs font-medium uppercase tracking-[0.18em] text-slate hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
        </div>

        <% if @game.paylines.any? %>
          <p class="mt-4 text-sm text-slate">
            <span class="font-mono text-ink"><%= pluralize(@game.paylines.size, "line") %></span>,
            each costing one unit of stake per spin.
          </p>
        <% else %>
          <p class="mt-4 text-sm text-slate">
            No paylines yet, so there is nothing for a spin to pay on.
          </p>
        <% end %>
      <% end %>
    </section>
  </div>

  <section data-variations class="border-t border-rule pt-10">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink">Variations</h2>

      <%= button_to "New variation", game_variations_path(@game),
            class: "cursor-pointer border border-ink px-3 py-1.5 font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink hover:bg-ink hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
    </div>

    <% if @game.variations.any? %>
      <ul class="mt-4 divide-y divide-rule border-y border-rule">
        <% @game.variations.each do |variation| %>
          <li class="py-3">
            <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1">
            <%= link_to variation.label, [ @game, variation ],
                  class: "font-mono text-ink underline underline-offset-4 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>

            <span class="font-mono text-xs text-slate">
              <% if variation.target_rtp_min %>
                target <%= variation.target_rtp_min_percentage %>&ndash;<%= variation.target_rtp_max_percentage %>
              <% else %>
                no target
              <% end %>
              &middot; <%= variation.reel_strips.size %>/<%= @game.reel_count %> strips
              &middot; <%= variation.paytable_entries.size %> paytable entries
            </span>
            </div>

            <%# Where you go looking when a game holds 01, 02 and 07 and you cannot
                remember which is which. %>
            <% if variation.note.present? %>
              <p data-variation-note class="mt-1 max-w-xl text-sm leading-relaxed text-slate"><%= variation.note %></p>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm text-slate">
        No variations yet. A variation holds the reel strips and paytable, so a game
        needs one before its maths can be described.
      </p>
    <% end %>
  </section>
</div>
