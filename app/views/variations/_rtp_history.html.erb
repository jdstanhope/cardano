<%# What the figure has been, newest first.

    A figure is recorded when the description it was computed from changes, so a row
    here is a change somebody made rather than a page they looked at. Nothing is
    recorded for a variation nobody has altered, which is why one figure alone shows
    no history at all. %>
<% if history.length > 1 %>
  <details class="mt-4 text-sm">
    <summary class="cursor-pointer font-mono text-xs uppercase tracking-[0.14em] text-slate hover:text-ink">
      History &middot; <%= pluralize(history.length, "figure") %>
    </summary>

    <ol class="mt-3 divide-y divide-rule border-y border-rule">
      <% history.each_with_index do |figure, index| %>
        <% earlier = history[index + 1] %>
        <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-2">
          <span class="font-mono text-base text-ink"><%= figure.to_percentage %></span>

          <span class="flex items-baseline gap-4 font-mono text-xs text-slate">
            <% if earlier %>
              <% points = figure.points_from(earlier) %>
              <span class="text-ink"><%= "%+.2f" % points %></span>
            <% else %>
              <%# The oldest figure held has nothing before it to be measured against —
                  which is not the same as it being where the variation started. %>
              <span class="text-slate/60">&mdash;</span>
            <% end %>
            <time datetime="<%= figure.created_at.iso8601 %>"><%= figure.created_at.strftime("%d %b %H:%M") %></time>
          </span>
        </li>
      <% end %>
    </ol>
  </details>
<% end %>
