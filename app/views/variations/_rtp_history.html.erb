<%# What the figure has been, newest first, and what moved it.

    A figure is recorded when the description it was computed from changes, so a row
    here is a change somebody made rather than a page they looked at. Nothing is
    recorded for a variation nobody has altered, which is why one figure alone shows
    no history at all. %>
<% if history.length > 1 %>
  <details class="mt-4 text-sm">
    <summary class="cursor-pointer font-mono text-xs uppercase tracking-[0.14em] text-slate hover:text-ink">
      History &middot; <%= pluralize(history.length, "figure") %>
    </summary>

    <ol class="mt-3 divide-y divide-rule border-y border-rule">
      <% history.each_with_index do |figure, index| %>
        <% earlier = history[index + 1] %>
        <% changes = figure.changes_from(earlier) %>

        <li class="py-2.5" data-figure="<%= figure.id %>">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <span class="font-mono text-base text-ink"><%= figure.to_percentage %></span>

            <span class="flex items-baseline gap-4 font-mono text-xs text-slate">
              <% if earlier %>
                <span class="text-ink"><%= "%+.2f" % figure.points_from(earlier) %></span>
              <% else %>
                <%# The oldest figure held has nothing before it to be measured against —
                    which is not the same as it being where the variation started. %>
                <span class="text-slate/60">&mdash;</span>
              <% end %>
              <time datetime="<%= figure.created_at.iso8601 %>"><%= figure.created_at.strftime("%d %b %H:%M") %></time>

              <%# Restoring appends rather than rewrites, so every row stays reachable
                  however far back it is. %>
              <% if figure.inputs.present? %>
                <%= link_to "Restore", new_game_variation_figure_restoration_path(figure.variation.game, figure.variation, figure),
                      class: "uppercase tracking-[0.14em] text-slate hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>

                <%# Keeping a configuration rather than returning to it: the same
                    machinery, writing a new variation instead of this one. %>
                <%= button_to "Branch", game_variation_figure_branch_path(figure.variation.game, figure.variation, figure),
                      form_class: "inline",
                      class: "cursor-pointer font-mono text-xs uppercase tracking-[0.14em] text-slate hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
              <% end %>
            </span>
          </div>

          <% if changes&.any? %>
            <%# What moved the figure. Changes to the game are marked as such: they are
                shared with every other variation, so one here was not necessarily made
                on this one. %>
            <ul data-changes class="mt-1.5 space-y-0.5 pl-1">
              <% changes.of_the_variation.each do |change| %>
                <li class="font-mono text-xs text-slate"><%= change %></li>
              <% end %>

              <% changes.of_the_game.each do |change| %>
                <li class="font-mono text-xs text-slate">
                  <%= change %>
                  <span class="text-slate/60">&mdash; the game's, shared with its other variations</span>
                </li>
              <% end %>
            </ul>
          <% elsif earlier && changes.nil? %>
            <%# Recorded before descriptions were kept, so there is nothing to compare.
                Saying so beats implying nothing changed. %>
            <p class="mt-1.5 pl-1 font-mono text-xs text-slate/60">recorded before changes were tracked</p>
          <% end %>
        </li>
      <% end %>
    </ol>
  </details>
<% end %>
