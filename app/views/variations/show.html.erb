<% content_for :title, "#{@game.name} #{@variation.label} — Cardano" %>

<div class="mx-auto max-w-3xl px-6 py-12 sm:py-16">
  <div class="border-b border-rule pb-6">
    <%= link_to @game.name, @game, class: "font-mono text-xs uppercase tracking-[0.18em] text-slate hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
    <div class="mt-2 flex flex-wrap items-baseline justify-between gap-4">
      <h1 class="text-3xl font-semibold tracking-tight">
        Variation <span class="font-mono"><%= @variation.label %></span>
      </h1>

      <%# Trying an alternative without risking the one that works. Variations exist to
          hold exactly this, so it is a copy into a new one rather than an edit here. %>
      <%= button_to "Copy to a new variation", game_variation_branch_path(@game, @variation),
            class: "border border-rule px-3 py-1.5 font-mono text-xs font-medium uppercase tracking-[0.18em] text-slate hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
    </div>

    <p class="mt-2 font-mono text-xs text-slate">
      <%= @game.reel_count %>&times;<%= @game.row_count %> window
      <% if @variation.target_rtp_min %>
        &middot; target <%= @variation.target_rtp_min_percentage %>&ndash;<%= @variation.target_rtp_max_percentage %>
      <% end %>
    </p>
  </div>

  <section data-rtp class="border-b border-rule py-10">
    <%= turbo_stream_from @variation %>
    <%= render "variations/return_to_player", variation: @variation %>
  </section>

  <section class="py-10">
    <h2 class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink">Reel strips</h2>

    <p class="mt-3 max-w-xl text-sm leading-relaxed text-slate">
      One code per stop, separated by spaces, commas, or new lines. The number of codes
      is the number of stops. <strong class="font-medium text-ink">Order matters</strong> —
      a spin shows several consecutive stops, so <span class="font-mono">A A K</span> and
      <span class="font-mono">A K A</span> are different reels.
    </p>

    <% if @game.symbols.any? %>
      <p class="mt-3 font-mono text-xs text-slate">
        Symbols: <%= @game.symbols.order(:position).map(&:code).join("  ") %>
      </p>

      <%= form_with url: game_variation_reel_strips_path(@game, @variation), method: :patch, class: "mt-8" do |form| %>
        <%# Reels side by side, each a column of stops. A reel is a vertical strip and
            the window shows consecutive stops stacked, so laying them out horizontally
            made the thing on screen look nothing like the thing described.

            Columns are independent and need not be the same height: reels may differ in
            length, and a ragged bottom edge is the truth about that. %>
        <%# Side by side and never wrapped: a wrapped reel 5 sits sixty-four rows below
            reel 1, which is worse than scrolling sideways to reach it. %>
        <div class="flex gap-x-6 overflow-x-auto pb-2">
          <% (1..@game.reel_count).each do |position| %>
            <% codes = @form.codes_for(position) %>
            <% error = @form.error_for(position) %>

            <div data-controller="reel" data-reel-position-value="<%= position %>" class="w-36 shrink-0">
              <%# Sticky: a sixty-four stop reel is taller than the window, and losing
                  track of which column you are typing into is the obvious way to ruin
                  a strip. %>
              <%# Two lines, centred over the column of stops. The same grid template as
                  a row, so the empty first cell carries the title past the number
                  gutter rather than centring it over the lot. %>
              <div class="sticky top-0 z-10 grid grid-cols-[1.5rem_1fr_2.25rem] gap-1.5 bg-paper py-2">
                <span></span>
                <span class="text-center">
                  <span class="block font-mono text-xs font-medium uppercase tracking-[0.14em] text-ink">Reel <%= position %></span>
                  <span data-reel-target="stops" class="mt-0.5 block font-mono text-xs text-slate"></span>
                </span>
                <span></span>
              </div>

              <div data-reel-target="rows" class="mt-2 space-y-1">
                <% codes.each_with_index do |code, index| %>
                  <%= render "variations/reel_row", position: position, number: index + 1, code: code, error: error %>
                <% end %>

                <%# A reel with nothing on it still needs somewhere to start typing. %>
                <% if codes.empty? %>
                  <%= render "variations/reel_row", position: position, number: 1, code: "", error: error %>
                <% end %>
              </div>

              <%# Cloned by the controller when a stop is added. Rendered with a
                  placeholder number, which renumber() corrects on insertion. %>
              <template data-reel-target="template"><%= render "variations/reel_row", position: position, number: 0, code: "", error: false %></template>

              <button type="button" data-action="reel#addStop" data-add-stop
                      class="mt-2 w-full cursor-pointer border border-rule px-2 py-1 font-mono text-xs uppercase tracking-[0.14em] text-slate hover:border-ink hover:text-ink">
                Add stop
              </button>

              <% if error %>
                <p data-reel-error="<%= position %>" class="mt-1.5 text-sm text-alert"><%= error %></p>
              <% end %>

              <%# whitespace-pre so the padded alignment survives: HTML collapses runs
                  of spaces and would undo it. %>
              <p data-reel-target="counts" class="mt-3 whitespace-pre pl-[1.875rem] font-mono text-xs leading-relaxed text-slate"></p>
            </div>
          <% end %>
        </div>

        <p class="mt-6 font-mono text-xs leading-relaxed text-slate">
          Enter or Tab moves down the column, and Enter on the last stop adds one.
          Shift+Enter inserts a stop above the one you are on, and Backspace on an empty
          stop removes it &mdash; or use the <span class="text-ink">+</span> and
          <span class="text-ink">&times;</span> on the row. Pasting a column of codes
          fills downwards.
        </p>

        <%= form.submit "Save reels",
              class: "mt-4 cursor-pointer bg-ink px-5 py-3 font-mono text-xs font-medium uppercase tracking-[0.18em] text-paper hover:bg-ink/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
      <% end %>
    <% else %>
      <p class="mt-4 text-sm text-slate">
        This game has no symbols yet.
        <%= link_to "Add some first", @game, class: "text-ink underline underline-offset-4 hover:no-underline" %>.
      </p>
    <% end %>
  </section>

  <% if @game.symbols.any? %>
    <section data-paytable class="border-t border-rule pt-10">
      <h2 class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink">Paytable</h2>

      <p class="mt-3 max-w-xl text-sm leading-relaxed text-slate">
        What each winning combination pays, in credits per unit of line stake. Edited in
        two parts: the same symbol repeated in the grid, everything else below it.
      </p>

      <h3 class="mt-8 font-mono text-xs font-medium uppercase tracking-[0.18em] text-slate">Same symbol repeated</h3>

      <p class="mt-2 max-w-xl text-sm leading-relaxed text-slate">
        A blank cell means that combination does not pay.
      </p>

      <%= form_with url: game_variation_paytable_path(@game, @variation), method: :patch, class: "mt-8" do |form| %>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="border-b border-rule">
                <th class="py-2 pr-4 text-left font-mono text-xs font-medium uppercase tracking-[0.18em] text-slate">Symbol</th>
                <% (1..@game.reel_count).each do |count| %>
                  <th class="px-2 py-2 text-left font-mono text-xs font-medium uppercase tracking-[0.18em] text-slate">&times;<%= count %></th>
                <% end %>
              </tr>
            </thead>

            <tbody class="divide-y divide-rule">
              <% @game.symbols.order(:position).each do |symbol| %>
                <tr>
                  <th scope="row" class="py-2 pr-4 text-left">
                    <span class="font-mono text-base text-ink"><%= symbol.code %></span>
                    <span class="ml-2 text-xs text-slate"><%= symbol.display_name %></span>
                  </th>

                  <%# A wild keeps its row, with the reason there are no inputs on
                      screen rather than left to be inferred from its absence. %>
                  <% if symbol.wild? %>
                    <td data-wild-row colspan="<%= @game.reel_count %>" class="px-2 py-2 text-sm text-slate">
                      Substitutes for other symbols &mdash; does not pay on its own.
                    </td>
                    <% next %>
                  <% end %>

                  <% (1..@game.reel_count).each do |count| %>
                    <% unless @game.payable_counts.cover?(count) %>
                      <%# Kept in the grid so the rule is visible: nothing pays for a
                          single symbol, so there is nowhere to type one. %>
                      <td class="px-2 py-2 text-center font-mono text-sm text-slate/60" aria-label="not payable">&ndash;</td>
                      <% next %>
                    <% end %>

                    <% error = @paytable.error_for(symbol, count) %>
                    <td class="px-2 py-2">
                      <label class="sr-only" for="payout_<%= symbol.id %>_<%= count %>"><%= symbol.code %> times <%= count %></label>
                      <input type="text"
                             inputmode="numeric"
                             id="payout_<%= symbol.id %>_<%= count %>"
                             name="payouts[<%= symbol.id %>][<%= count %>]"
                             value="<%= @paytable.value_for(symbol, count) %>"
                             class="block w-20 border <%= error ? "border-alert" : "border-rule" %> bg-white px-2 py-1.5 text-right font-mono text-ink focus:border-ink focus:outline-none">
                      <% if error %>
                        <span data-payout-error="<%= symbol.id %>-<%= count %>" class="mt-1 block text-xs text-alert"><%= error %></span>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <%= form.submit "Save paytable",
              class: "mt-8 cursor-pointer bg-ink px-5 py-3 font-mono text-xs font-medium uppercase tracking-[0.18em] text-paper hover:bg-ink/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
      <% end %>

      <%# Named in full: PaytablesController and ReelStripsController re-render this
          template, and a bare name is looked up against the controller. %>
      <div class="mt-12 border-t border-rule pt-8">
        <%= render "variations/mixed_combinations", variation: @variation %>
      </div>
    </section>
  <% end %>
</div>
