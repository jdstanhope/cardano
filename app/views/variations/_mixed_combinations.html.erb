<%# The combinations the grid cannot express: anything that mixes symbols or names a
    group.

    Deliberately disjoint from the grid above, which edits the same symbol repeated.
    Every combination is editable in exactly one place — the grid is much quicker for
    thirty N-of-a-kind payouts, and this is the only thing that can express the rest,
    so each keeps the shape it is good at and neither duplicates the other. %>
<% combinations = variation.paytable.reject(&:n_of_a_kind?).sort_by { |entry| [ -entry.payout, entry.length ] } %>
<% game = variation.game %>

<div class="mt-8">
  <h3 class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-slate">Mixed and group combinations</h3>

  <p class="mt-2 max-w-xl text-sm leading-relaxed text-slate">
    Combinations spanning different symbols, or naming a group. The grid above covers
    the same symbol repeated; these have no cell there.
  </p>

  <% if combinations.any? %>
    <ul class="mt-4 divide-y divide-rule border-y border-rule">
      <% combinations.each do |entry| %>
        <%# The edit form and the remove form are siblings in one flex row: a destroy
            cannot share a form with the save beside it. %>
        <li class="grid grid-cols-[1fr_auto] items-center gap-x-3 py-2.5" data-combination="<%= entry.id %>">
          <%= form_with url: game_variation_combination_path(game, variation, entry), method: :patch,
                        class: "flex flex-wrap items-center gap-x-3 gap-y-2" do %>
            <%= render "variations/combination_positions", game: game, matchers: entry.matchers.to_a %>

            <label class="sr-only" for="payout_<%= entry.id %>">Payout</label>
            <input type="text" inputmode="numeric" id="payout_<%= entry.id %>" name="payout"
                   value="<%= entry.payout %>"
                   class="w-20 border border-rule bg-white px-2 py-1 text-right font-mono text-sm text-ink focus:border-ink focus:outline-none">

            <button type="submit" class="cursor-pointer border border-rule px-2.5 py-1 font-mono text-xs uppercase tracking-[0.14em] text-slate hover:border-ink hover:text-ink">Save</button>
          <% end %>

          <%= button_to "Remove", game_variation_combination_path(game, variation, entry), method: :delete,
                form_class: "justify-self-end",
                class: "cursor-pointer border border-transparent px-2.5 py-1 font-mono text-xs uppercase tracking-[0.14em] text-slate hover:border-alert hover:text-alert" %>
        </li>
      <% end %>
    </ul>

    <p class="mt-3 text-xs leading-relaxed text-slate">
      <%= pluralize(combinations.count, "combination") %> here, and
      <%= variation.paytable.count(&:n_of_a_kind?) %> in the grid above:
      <%= pluralize(variation.paytable.count, "combination") %> in total.
    </p>
  <% else %>
    <p class="mt-4 text-sm text-slate">None yet. The grid above holds
      <%= pluralize(variation.paytable.count, "combination") %>.</p>
  <% end %>

  <div class="mt-6 border-t border-rule pt-5">
    <h4 class="font-mono text-xs uppercase tracking-[0.14em] text-slate">Add a combination</h4>

    <%= form_with url: game_variation_combinations_path(game, variation),
                  class: "mt-3 flex flex-wrap items-center gap-x-3 gap-y-2" do %>
      <%= render "variations/combination_positions", game: game, matchers: [] %>

      <label class="sr-only" for="payout_new">Payout</label>
      <input type="text" inputmode="numeric" id="payout_new" name="payout" placeholder="pays"
             class="w-24 border border-rule bg-white px-2 py-1 text-right font-mono text-sm text-ink focus:border-ink focus:outline-none">

      <button type="submit" class="cursor-pointer border border-ink px-3 py-1 font-mono text-xs uppercase tracking-[0.14em] text-ink hover:bg-ink hover:text-paper">Add</button>
    <% end %>

    <p class="mt-2 text-xs leading-relaxed text-slate">
      Positions are matched from the leftmost reel, so order is part of what a
      combination means. A group position accepts any of its symbols. The same symbol
      in every position belongs in the grid above, and will move there.
    </p>
  </div>
</div>
