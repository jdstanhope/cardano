<%# How often each combination actually landed.
    The interval above is computed from the spread of what was seen. Before a rare
    combination lands, that spread is missing its tail, and the interval is confident
    about an accuracy the run has not earned — which nothing in the sample can detect.
    So the counts are shown, largest payout first, and the ones too thin to have settled
    anything are marked. The reader should be able to notice the one line that undermines
    the figure without reading all fifteen. %>
<% if figure.coverage.present? %>
  <div data-coverage class="mt-6 border-t border-rule pt-5">
    <h3 class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-slate">Coverage</h3>

    <ol class="mt-3 divide-y divide-rule border-y border-rule text-sm">
      <% figure.coverage.each do |line| %>
        <% thin = line["hits"] < RtpFigure::WELL_SEEN %>
        <li data-combination="<%= line["combination"] %>" <%= "data-thin" if thin %>
            class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-2">
          <span class="flex items-baseline gap-3">
            <span class="font-mono text-xs text-ink"><%= line["combination"] %></span>
            <span class="font-mono text-xs text-slate">&times;<%= number_with_delimiter line["payout"] %></span>
          </span>

          <span class="flex items-baseline gap-3 font-mono text-xs <%= thin ? "text-alert" : "text-slate" %>">
            <span>seen <%= number_with_delimiter line["hits"] %> <%= "time".pluralize(line["hits"]) %></span>
            <% if thin %>
              <span class="uppercase tracking-[0.14em]">thin</span>
            <% end %>
          </span>
        </li>
      <% end %>
    </ol>
  </div>
<% end %>
